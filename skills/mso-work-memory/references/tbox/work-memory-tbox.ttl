@prefix wm: <https://mso.dev/ontology/work-memory#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wm:Entry a owl:Class ;
    rdfs:label "Work Memory Entry" .

wm:ExternalReference a owl:Class ;
    rdfs:label "External Reference" .

wm:IssueNote a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:AgentDecision a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:UserDecision a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:AlternativesRecord a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:TroubleShooting a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:ReleaseNote a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:Episode a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:Pattern a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:Principle a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:AuditLog a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:WorkLog a owl:Class ;
    rdfs:subClassOf wm:Entry .

wm:entryId a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string .

wm:typeName a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string .

# schema v1.4.0 (MSO v0.16.0): description/content 가 title/text 를 대체한다.
# description 은 본문(content)을 펼칠지 판단하는 문구이며 최대 200자(SHACL sh:maxLength).
wm:description a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string ;
    rdfs:comment "본문을 펼칠지 판단하는 문구. 최대 200자. 옛 title 의 후속."@ko .

wm:content a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string ;
    rdfs:comment "본문. 점진적 주입에서 필요할 때만 펼친다. 옛 text 의 후속."@ko .

wm:title a owl:DatatypeProperty ;
    owl:deprecated true ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string ;
    rdfs:comment "deprecated (v0.16.0): wm:description 사용. 투영은 더 이상 내보내지 않는다."@ko .

wm:text a owl:DatatypeProperty ;
    owl:deprecated true ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string ;
    rdfs:comment "deprecated (v0.16.0): wm:content 사용. 투영은 더 이상 내보내지 않는다."@ko .

# related 매핑: entry → workflow node. 객체는 https://mso.dev/ontology/workflow#node/<id> IRI.
wm:relatedNode a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:comment "이 기록이 연관된 workflow node (JSONL 의 최상위 node 필드). 매핑된 node 에서만 주입한다."@ko .

wm:relatedNodeId a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string ;
    rdfs:comment "연관 workflow node 의 id 문자열. node IRI 는 workflow 마다 경로가 달라 join 은 이 값으로 한다."@ko .

# ── 파생 속성 (투영 시 계산, JSONL 에 저장하지 않는다 — UD-0012) ──
wm:validity a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string ;
    rdfs:comment "파생: active | superseded | invalidated | deprecated | suspended. relations 에서 도출한다(wm_release.derive_validity)."@ko .

wm:supersededBy a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:Entry ;
    rdfs:comment "파생: 이 entry 를 supersedes 로 가리키는 entry. wm:supersedes 의 역."@ko .

wm:versionKey a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:integer ;
    rdfs:comment "파생: RN 의 metadata.version(semver) 을 major*1000000+minor*1000+patch 정수로 바꾼 정렬 키. 문자열 사전순 비교의 오류(0.9.0 > 0.15.0)를 피한다."@ko .

wm:validFromVersion a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string ;
    rdfs:comment "파생: released-in/verified-in 대상 RN 중 가장 이른 버전."@ko .

wm:validFromKey a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:integer ;
    rdfs:comment "파생: validFromVersion 의 versionKey."@ko .

wm:invalidatedInVersion a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string ;
    rdfs:comment "파생: 롤백되지 않은 invalidated-by 대상 RN 중 가장 이른 버전."@ko .

wm:invalidatedInKey a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:integer ;
    rdfs:comment "파생: invalidatedInVersion 의 versionKey."@ko .

wm:tag a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string .

wm:createdAt a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string .

wm:sourcePath a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string .

# v0.16.0: author 는 문자열이 아니라 주체(Agent) 개체다. 소속(계정 주인)과 백그라운드 구분은 metadata TBox(생성) 참조.
wm:author a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:Agent .

# JSONL metadata 전체의 JSON 리터럴(원본 보존). 명세에 있는 키는 별도 프로퍼티로도 내보낸다(work-memory-metadata-tbox.ttl).
wm:metadata a owl:DatatypeProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range xsd:string .

wm:externalValue a owl:DatatypeProperty ;
    rdfs:domain wm:ExternalReference ;
    rdfs:range xsd:string .

wm:raised a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:Entry .

wm:followedBy a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:Entry .

wm:resolvedBy a owl:ObjectProperty ;
    rdfs:domain wm:IssueNote ;
    rdfs:range wm:TroubleShooting .

wm:causedBy a owl:ObjectProperty ;
    rdfs:domain wm:TroubleShooting ;
    rdfs:range wm:IssueNote .

wm:releasedIn a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:ReleaseNote .

wm:verifiedIn a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:ReleaseNote .

wm:invalidatedBy a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:ReleaseNote .

wm:rollsBack a owl:ObjectProperty ;
    rdfs:domain wm:ReleaseNote ;
    rdfs:range wm:ReleaseNote .

wm:analyzedIn a owl:ObjectProperty ;
    rdfs:domain wm:TroubleShooting ;
    rdfs:range wm:Episode .

wm:showsPattern a owl:ObjectProperty ;
    rdfs:domain wm:Episode ;
    rdfs:range wm:Pattern .

wm:generalizedIn a owl:ObjectProperty ;
    rdfs:domain wm:Episode ;
    rdfs:range wm:Pattern .

wm:crystallizedIn a owl:ObjectProperty ;
    rdfs:domain wm:Pattern ;
    rdfs:range wm:Principle .

wm:references a owl:ObjectProperty ;
    rdfs:domain wm:Entry .

wm:supersedes a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:Entry .

wm:refines a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:Entry .

wm:dependsOn a owl:ObjectProperty ;
    rdfs:domain wm:Entry ;
    rdfs:range wm:Entry .
