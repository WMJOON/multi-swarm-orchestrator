wm:prevention a owl:DatatypeProperty ; rdfs:domain wm:Entry ; rdfs:range xsd:string .
wm:principleStatus a owl:ObjectProperty ; rdfs:domain wm:Entry ; rdfs:range wm:PrincipleStatus .
wm:providedBy a owl:ObjectProperty ; rdfs:domain wm:Entry ; rdfs:range wm:Agent .
